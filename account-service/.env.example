# Run behind HTTPS in production. Set environment variables before starting.
LENS_DB=paymentlens.sqlite3
LENS_ORIGIN=http://localhost:5173
LENS_RP_ID=localhost
# Development ONLY: allows HTTP cookies on localhost. Never use 1 in production.
LENS_INSECURE_LOCAL=1
LENS_SESSION_SECONDS=3600
# Optional: server-side AI. Never put this key in VITE_ variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=25
# Optional password recovery mail delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
