# Analysis and Solana evidence service (Person 1 backend). Override for deployment or leave empty for local-only demonstrations.
VITE_API_BASE_URL=http://127.0.0.1:8001
# Account database/passkey service. Set to http://localhost:8002 for local account integration.
VITE_ACCOUNT_API_BASE_URL=http://localhost:8002
# Document upload is supported by the shared backend; images are OCR'd in the browser.
VITE_ENABLE_DOCUMENT_UPLOAD=true
